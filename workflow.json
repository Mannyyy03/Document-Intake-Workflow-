        "messages": {
          "values": [
            {
              "content": "=You extract data from invoices. Return ONLY a JSON object with these keys: invoice_number (string), vendor (string), invoice_date (YYYY-MM-DD), total (number, no currency symbol), category (one of: Office Supplies, Software, Travel, Utilities, Services, Other). If a field is missing, use null. No explanation and no markdown.\n\nInvoice text:\n{{ $json.data }}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "id": "f0c84bca-3424-4225-be8b-9de6c7fe3b45",
      "name": "Message a model",
      "credentials": {
        "ollamaApi": {
          "id": "RoEoWqQHAMJeLze9",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const allowed = ['Office Supplies','Software','Travel','Utilities','Services','Other'];\n\nfunction getReply(j) {\n  return j.content ?? j.text ?? j.output ?? j.response?.text\n    ?? j.message?.content ?? j.choices?.[0]?.message?.content;\n}\n\nreturn $input.all().map(item => {\n  const reply = getReply(item.json);\n  let data = null;\n  let error = null;\n  try {\n    if (reply === undefined || reply === null || reply === '') {\n      throw new Error('no AI reply found; fields seen: ' + Object.keys(item.json).join(', '));\n    }\n    data = (typeof reply === 'object')\n      ? reply\n      : JSON.parse(String(reply).replace(/```json|```/g, '').trim());\n    if (!data.invoice_number) error = 'missing invoice_number';\n    else if (!data.vendor) error = 'missing vendor';\n    else if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(data.invoice_date) || isNaN(Date.parse(data.invoice_date))) error = 'bad date';\n    else if (typeof data.total !== 'number' || data.total <= 0) error = 'bad total';\n    else if (!allowed.includes(data.category)) error = 'bad category';\n  } catch (e) {\n    error = 'invalid JSON: ' + e.message;\n  }\n  const rawText = (typeof reply === 'string') ? reply : JSON.stringify(reply ?? null);\n  return { json: { valid: !error, error, raw_output: rawText, ...(data || {}) } };\n});"
      },
